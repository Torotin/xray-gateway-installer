# Xray Gateway Installer - Оптимизация сетевых параметров ядра
# Версия: 2.3.0
# Создано: {{CREATION_DATE}}
# Файл: {{SYSCTL_FILE_PATH}}
# Оптимизация для: VPN Gateway с Xray (высокая пропускная способность, низкие задержки)

##################### Ядро сети и производительность #####################
# Алгоритм очередей по умолчанию для интерфейсов
# fq (Fair Queueing) - оптимален для VPN и туннелирования
net.core.default_qdisc = fq

# Алгоритм управления перегрузками TCP
# BBR - лучший для VPN и высокоскоростных соединений
net.ipv4.tcp_congestion_control = bbr

# Включение маршрутизации IPv4 (обязательно для VPN Gateway)
net.ipv4.ip_forward = 1

# Максимальное количество пакетов в очереди интерфейса
# Увеличено для высокоскоростных VPN соединений
net.core.netdev_max_backlog = 500000

# Размеры сокетных буферов (оптимизированы для VPN)
# Увеличены для обработки больших объемов трафика
net.core.rmem_default = 524288
net.core.rmem_max = 268435456
net.core.wmem_default = 524288
net.core.wmem_max = 268435456

# Максимальное количество соединений в очереди
# Критично для VPN серверов с множественными подключениями
net.core.somaxconn = 2048

##################### UDP буферы (критично для VPN) #####################
# UDP буферы для OpenVPN, WireGuard, и других VPN протоколов
net.ipv4.udp_mem = 131072 262144 524288
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384

##################### TCP ускорение и оптимизация #####################
# RFC 1337 - защита от TIME-WAIT атак
net.ipv4.tcp_rfc1337 = 1

# Низкая задержка для VPN соединений
net.ipv4.tcp_low_latency = 1

# Увеличенная очередь для SYN-пакетов (защита от DDoS)
net.ipv4.tcp_max_syn_backlog = 8192

# Повторное использование сокетов в состоянии TIME-WAIT
net.ipv4.tcp_tw_reuse = 1

# Быстрое закрытие соединений
net.ipv4.tcp_fin_timeout = 10

# Keepalive настройки для VPN соединений
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_keepalive_intvl = 30

# MTU probing для VPN туннелей
net.ipv4.tcp_mtu_probing = 2

# TCP Fast Open (улучшает производительность)
net.ipv4.tcp_fastopen = 3

# Отключение медленного старта после простоя
net.ipv4.tcp_slow_start_after_idle = 0

# SACK для лучшей производительности
net.ipv4.tcp_sack = 1

# Отключение timestamps для снижения накладных расходов
net.ipv4.tcp_timestamps = 0

# Масштабирование окна TCP
net.ipv4.tcp_window_scaling = 1

# Умеренное управление буферами
net.ipv4.tcp_moderate_rcvbuf = 1

# ECN (Explicit Congestion Notification)
net.ipv4.tcp_ecn = 1

# Увеличенные лимиты для высоконагруженных VPN серверов
net.ipv4.tcp_max_tw_buckets = 2000000
net.ipv4.tcp_max_orphans = 2000000

##################### Защита и фильтрация #####################
# SYN cookies для защиты от SYN flood
net.ipv4.tcp_syncookies = 1

# Игнорирование ICMP broadcast
net.ipv4.icmp_echo_ignore_broadcasts = 1

# Ограничение ICMP rate
net.ipv4.icmp_ratelimit = 100

# Строгая проверка обратного пути
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# Отключение source routing
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0

# Отключение redirects
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# Отключение secure redirects
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0

# Отключение send redirects
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

##################### ARP фильтрация #####################
# ARP фильтрация для безопасности
net.ipv4.conf.all.arp_filter = 1
net.ipv4.conf.default.arp_filter = 1

# Отключение ARP announce
net.ipv4.conf.all.arp_announce = 2
net.ipv4.conf.default.arp_announce = 2

# Отключение ARP ignore
net.ipv4.conf.all.arp_ignore = 1
net.ipv4.conf.default.arp_ignore = 1

##################### Отключение IPv6 (оптимизация для VPN) #####################
# Полное отключение IPv6 для снижения накладных расходов
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1

# Отключение IPv6 autoconf
net.ipv6.conf.all.autoconf = 0
net.ipv6.conf.default.autoconf = 0

# Отключение IPv6 router advertisements
net.ipv6.conf.all.accept_ra = 0
net.ipv6.conf.default.accept_ra = 0

##################### Оптимизация памяти для VPN #####################
# Снижение использования swap (критично для VPN серверов)
vm.swappiness = 1

# Оптимизация кэша файловой системы
vm.vfs_cache_pressure = 50

# Увеличение лимитов файловых дескрипторов
fs.file-max = 2097152

##################### Дополнительные настройки безопасности #####################
# Отключение ping broadcast
net.ipv4.icmp_echo_ignore_all = 0

# Ограничение количества пакетов в секунду
net.ipv4.icmp_ratemask = 0

# Отключение IP forwarding для IPv6
net.ipv6.conf.all.forwarding = 0
net.ipv6.conf.default.forwarding = 0

##################### Настройки для высоконагруженных VPN серверов #####################
# Увеличение лимитов соединений
net.core.netdev_budget = 600
net.core.netdev_budget_usecs = 5000

# Оптимизация для многоядерных систем
net.core.rps_sock_flow_entries = 32768

# Увеличение лимитов для сетевых интерфейсов
net.core.netdev_max_backlog = 500000
net.core.netdev_tstamp_prequeue = 0